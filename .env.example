# Values come from the connected Supabase project (server-side unless noted).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of email addresses allowed to edit trips.
ADMIN_EMAILS=

# Set to true only after enabling Google Auth in Supabase with a Google OAuth client.
GOOGLE_AUTH_ENABLED=false

# Protects the Vercel daily database-read job. Set this in Vercel Production.
CRON_SECRET=

# Production URL used in Supabase's magic-link redirect settings.
SITE_URL=https://travel-film-archive.vercel.app
